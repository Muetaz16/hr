model LeaveRequest {
  id                   String    @id @default(uuid())
  employeeId           String
  userId               String
  type                 String
  startDate            DateTime
  endDate              DateTime?
  startTime            String?
  endTime              String?
  reason               String?
  // Work Authorization (out-work) specifics — only set when type === 'WORK_AUTHORIZATION'. The
  // work-order category (Site Mission / Official Business / Out of Office / …) and the place the
  // assignment is carried out. Used to fill the Work Authorization Form and to compose the reason
  // written to BioTime's `outworks` table on final approval.
  workOrderType        String?
  placeOfAssignment    String?
  // Missing Biometric Log (missing-punch) specifics — only set when type === 'MISSING_PUNCH'.
  // missingPunchType: CHECK_IN | CHECK_OUT | BOTH. missingPunchReason: FORGOT | DEVICE_ISSUE |
  // POWER_OUTAGE | OTHERS. On final approval the forgotten punch(es) are written to BioTime via
  // /api/attendance/missing-punches (09:00 in / 17:00 out). Work location comes from the JD, not stored here.
  missingPunchType     String?
  missingPunchReason   String?
  attachmentUrl        String?
  attachmentName       String?
  // Supporting document the General Manager must upload before granting the final approval.
  finalDocumentUrl     String?
  finalDocumentName    String?
  managerNote          String?
  hrNote               String?
  status               String    @default("PENDING")
  // Replacement (cover) employee the requester nominates. The nominee must accept before the
  // manager approval chain unblocks; their saved signature is then stamped on the form.
  // replacementStatus: null = not required (requester had no eligible colleague) |
  // PENDING | APPROVED | REJECTED.
  replacementUserId    String?
  replacementStatus    String?
  replacementDecidedAt DateTime?
  replacementUser      User?     @relation("LeaveReplacement", fields: [replacementUserId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deptApprovedById     String?
  divisionApprovedById String?
  directorApprovedById String?
  unitApprovedById     String?
  deptApprovedBy       User?     @relation("LeaveDeptApprovals", fields: [deptApprovedById], references: [id])
  divisionApprovedBy   User?     @relation("LeaveDivisionApprovals", fields: [divisionApprovedById], references: [id])
  directorApprovedBy   User?     @relation("LeaveDirApprovals", fields: [directorApprovedById], references: [id])
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitApprovedBy       User?     @relation("LeaveUnitApprovals", fields: [unitApprovedById], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalSteps        LeaveApprovalStep[]

  @@index([employeeId])
  @@index([userId])
  @@index([status])
  @@index([replacementUserId])
}

// Per-approver-per-stage tracking for the leave-request approval chain (Unit head -> Department/
// Office head -> Division head -> HR Manager -> Administrative Director -> General Manager,
// skipping whichever org levels don't apply to a given employee). Only used for PAID_HOLIDAY/
// UNPAID_LEAVE/EMERGENCY_LEAVE requests on LeaveRequest — the old fixed approver columns above
// stay in use for the other request types (LATE_COMING/EARLY_LEAVING/HOURS_LEAVE).
model LeaveApprovalStep {
  id             String    @id @default(uuid())
  leaveRequestId String
  sequence       Int       // shared by every row belonging to the same logical stage
  stage          String    // UNIT_HEAD | DEPT_HEAD | DIVISION_HEAD | HR_MANAGER | ADMIN_DIRECTOR | GENERAL_MANAGER
  // The printed form rows this single signature fills. One person can hold several posts (e.g. the
  // division head IS the direct manager, or the director IS the direct manager), so they sign once
  // but their signature is shown in every row they cover. Values are FORM-row stages:
  // HEAD_ATTENDANCE | DIRECT_SUPERVISOR | HEAD_DEPT_DIVISION | HR_MANAGER | DIRECTORATE | GENERAL_MANAGER.
  coversStages   String[]  @default([])
  approverUserId String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver     User         @relation("LeaveApprovalStepApprover", fields: [approverUserId], references: [id])

  @@index([leaveRequestId])
  @@index([approverUserId, status])
  @@unique([leaveRequestId, sequence, approverUserId])
}

