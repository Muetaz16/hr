generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid())
  email                    String                 @unique
  password                 String
  fullName                 String?
  role                     String
  departmentId             String?
  groupId                  String?
  createdAt                DateTime               @default(now())
  departmentIds            String[]               @default([])
  unitId                   String?
  permissions              String[]               @default([])
  announcements            Announcement[]
  requestedAssets          AssetRequest[]         @relation("AssetRequester")
  deptEvaluations          DepartmentEvaluation[] @relation("DeptEvaluationsSubmittedBy")
  directorEvaluations      DirectorEvaluation[]   @relation("DirectorEvaluationsSubmittedBy")
  divisionEvaluations      DivisionEvaluation[]   @relation("DivisionEvaluationsSubmittedBy")
  gmEvaluations            GMEvaluation[]         @relation("GMEvaluationsSubmittedBy")
  chairmanEvaluations      ChairmanEvaluation[]   @relation("ChairmanEvaluationsSubmittedBy")
  employee                 Employee?
  enabledPeriods           EvaluationPeriod[]
  hrEvaluations            HREvaluation[]         @relation("HREvaluationsSubmittedBy")
  leaveDeptApprovals       LeaveRequest[]         @relation("LeaveDeptApprovals")
  leaveDivisionApprovals   LeaveRequest[]         @relation("LeaveDivisionApprovals")
  leaveDirApprovals        LeaveRequest[]         @relation("LeaveDirApprovals")
  leaveUnitApprovals       LeaveRequest[]         @relation("LeaveUnitApprovals")
  leaveRequests            LeaveRequest[]
  notifications            Notification[]
  personnelEvaluations     PersonnelEvaluation[]  @relation("PersonnelEvaluationsSubmittedBy")
  deptRecruitmentApprovals RecruitmentRequest[]   @relation("RecruitmentDeptApproval")
  gmRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentGMApproval")
  hrRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentHRApproval")
  recruitmentRequests      RecruitmentRequest[]   @relation("RecruitmentRequester")
  candidatesCreated        Candidate[]            @relation("CandidateCreator")
  candidatesScreened       Candidate[]            @relation("CandidateScreener")
  candidatesHrEvaluated    Candidate[]            @relation("CandidateHrEvaluator")
  candidatesTechEvaluated  Candidate[]            @relation("CandidateTechEvaluator")
  assignedTasks            StaffTask[]            @relation("TasksAssignedTo")
  authoredTasks            StaffTask[]            @relation("TasksAuthoredBy")
  supportTickets           SupportTicket[]        @relation("TicketRequester")
  assignedSupportTickets   SupportTicket[]        @relation("TicketAssignee")
  unitEvaluations          UnitEvaluation[]       @relation("UnitEvaluationsSubmittedBy")
}

model Group {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
}

model Department {
  id                  String               @id @default(uuid())
  name                String
  groupId             String?
  employees           Employee[]
  evaluationPeriods   EvaluationPeriod[]
  recruitmentRequests RecruitmentRequest[]
  StaffTask           StaffTask[]
  units               Unit[]
  divisionId          String?
  isOffice            Boolean              @default(false)
  positionFactor      Float                @default(1.0)
  division            Division?            @relation(fields: [divisionId], references: [id])
  jobDescriptions     JobDescription[]
}

model Directorate {
  id          String       @id @default(uuid())
  name        String
  divisions   Division[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  positionFactor Float     @default(1.0)
  jobDescriptions JobDescription[]
}

model Division {
  id                  String               @id @default(uuid())
  name                String
  directorateId       String?
  directorate         Directorate?         @relation(fields: [directorateId], references: [id])
  departments         Department[]
  employees           Employee[]
  positionFactor      Float                @default(1.0)
  jobDescriptions     JobDescription[]
  recruitmentRequests RecruitmentRequest[]
}

model Unit {
  id                  String               @id @default(uuid())
  name                String
  departmentId        String
  headcount           Int                  @default(0)
  employees           Employee[]
  recruitmentRequests RecruitmentRequest[]
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobDescriptions     JobDescription[]
}

model JobDescription {
  id             String       @id @default(uuid())
  title          String
  description    String?
  isHead         Boolean      @default(false)
  plannedCount   Int          @default(1)
  jobCategories  String[]     @default([])
  workLocations  String[]     @default([])
  details        Json?
  directorateId  String?
  divisionId     String?
  departmentId   String?
  unitId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  directorate    Directorate? @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  division       Division?    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees      Employee[]
  recruitmentRequests RecruitmentRequest[]

  @@index([directorateId])
  @@index([divisionId])
  @@index([departmentId])
  @@index([unitId])
}

model Employee {
  id                     String                 @id @default(uuid())
  fullName               String
  email                  String?                @unique
  role                   String                 @default("EMPLOYEE")
  departmentId           String?
  groupId                String?
  baseSalary             Float                  @default(0)
  joinDate               DateTime
  staffId                String?
  contractEndDate        DateTime?
  contractStartDate      DateTime?
  contractStatus         String?
  contractType           String?
  holidaysUsed           Float                  @default(0)
  bonusHolidays          Float                  @default(0)
  userId                 String?                @unique
  unitId                 String?
  position               String?
  placeOfWork            String?
  contractNumber         String?
  emergencyHolidaysUsed  Float                  @default(0)
  fullNameArabic         String?
  jobCategory            String?
  jobGrade               String?
  salaryStructureType    String?
  nationality            String?
  passportNumber         String?
  unpaidHolidaysUsed     Float                  @default(0)
  accruedHolidays        Float                  @default(0)
  bonusEmergencyHolidays Float                  @default(0)
  earnedHolidays         Float                  @default(0)
  remainingHolidays      Float                  @default(0)
  positionFactor         Float                  @default(1.0)
  roleCategory           String?                @default("Support")
  siteFactor             Float                  @default(1.0)
  skillFactor            Float                  @default(1.0)
  languageFactor         Float                  @default(1.0)
  evaluationPoints       Float                  @default(0)
  promotionNotified      Boolean                @default(false)
  // --- Extended Identity Details (recruitment intake form) ---
  dateOfBirth                DateTime?
  placeOfBirth               String?
  nationalId                 String?
  academicQualification      String?
  gender                     String?
  bloodType                  String?
  idCardNumber               String?
  idPlaceOfIssue             String?
  idIssueDate                DateTime?
  passportPlaceOfIssue       String?
  passportExpiryDate         DateTime?
  drivingLicenseType         String?
  drivingLicenseNumber       String?
  drivingLicenseExpiry       DateTime?
  drivingLicensePlaceOfIssue String?
  personalPhone              String?
  personalEmail              String?
  emergencyContactNumber     String?
  residentialAddress         String?
  workedBefore               String?
  hasRelativesInCompany      String?
  relativesNames             String?
  bankName                   String?
  bankBranchName             String?
  bankAccountNumber          String?
  arrivalDate                DateTime?
  cvUrl                      String?
  degreeUrl                  String?
  birthCertUrl               String?
  passportCopyUrl            String?
  bankCheckUrl               String?
  photoUrl                   String?
  idCardUrl                  String?
  jobOfferUrl                String?
  healthCertUrl              String?
  jobDescriptionId       String?
  jobDescription         JobDescription?        @relation(fields: [jobDescriptionId], references: [id])
  assetRequests          AssetRequest[]
  contracts              Contract[]
  departmentEvaluations  DepartmentEvaluation[]
  directorEvaluations    DirectorEvaluation[]
  divisionEvaluations    DivisionEvaluation[]
  gmEvaluations          GMEvaluation[]
  chairmanEvaluations    ChairmanEvaluation[]
  divisionId             String?
  directorateId          String?
  directorate            Directorate?           @relation(fields: [directorateId], references: [id])
  division               Division?              @relation(fields: [divisionId], references: [id])
  department             Department?            @relation(fields: [departmentId], references: [id])
  group                  Group?                 @relation(fields: [groupId], references: [id])
  unit                   Unit?                  @relation(fields: [unitId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  hrEvaluations          HREvaluation[]
  leaveRequests          LeaveRequest[]
  payrollResults         PayrollResult[]
  personnelEvaluations   PersonnelEvaluation[]
  timeRecords            TimeRecord[]
  unitEvaluations        UnitEvaluation[]

  @@index([departmentId])
  @@index([unitId])
  @@index([groupId])
  @@index([jobDescriptionId])
}

model Contract {
  id                    String    @id @default(uuid())
  employeeId            String
  contractNumber        String?
  startDate             DateTime
  endDate               DateTime?
  type                  String?
  status                String    @default("ACTIVE")
  salary                Float     @default(0)
  notes                 String?
  documentUrl           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  emergencyHolidaysUsed Float     @default(0)
  holidaysUsed          Float     @default(0)
  jobCategory           String?
  jobGrade              String?
  position              String?
  unpaidHolidaysUsed    Float     @default(0)
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EvaluationPeriod {
  id           String      @id @default(uuid())
  month        String
  departmentId String?
  enabled      Boolean     @default(false)
  enabledById  String?
  enabledAt    DateTime    @default(now())
  notes        String?
  department   Department? @relation(fields: [departmentId], references: [id])
  enabledBy    User?       @relation(fields: [enabledById], references: [id])
}

model TimeRecord {
  id            String   @id @default(uuid())
  employeeId    String
  month         String
  assignedHours Float    @default(0)
  workedHours   Float    @default(0)
  overtimeHours Float    @default(0)
  absences      Int      @default(0)
  lateMinutes   Int      @default(0)
  status        String   @default("draft")
  updatedAt     DateTime @default(now()) @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, month])
}

model HREvaluation {
  id                  String    @id @default(uuid())
  employeeId          String
  month               String
  absenceUnauthorized Int       @default(0)
  delayMinutes        Int       @default(0)
  emergencyLeaves     Int       @default(0)
  unpaidLeaves        Int       @default(0)
  annualPaidLeaves    Int       @default(0)
  absenceScore        Float?
  delayScore          Float?
  emergencyScore      Float?
  unpaidScore         Float?
  violationScore      Float?
  presenceScore       Float?
  status              String    @default("draft")
  submittedAt         DateTime?
  submittedById       String?
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy         User?     @relation("HREvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model UnitEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
  submittedById    String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("UnitEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model DepartmentEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
  submittedById    String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("DeptEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model DirectorEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  finalScore       Float?
  locked           Boolean   @default(false)
  lockedAt         DateTime?
  submittedById    String?
  appearance       Float?
  commSkills       Float?
  contDev          Float?
  dataPrivacy      Float?
  orgCompliance    Float?
  pressureHandling Float?
  probSolving      Float?
  regAdherence     Float?
  regCompliance    Float?
  relColleagues    Float?
  resPreservation  Float?
  safetyAdherence  Float?
  taskQuality      Float?
  teamwork         Float?
  timeCommit       Float?
  workOrg          Float?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("DirectorEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model PersonnelEvaluation {
  id                     String   @id @default(uuid())
  employeeId             String
  month                  String
  warningMessages        Int      @default(0)
  disciplinaryDeduction  Int      @default(0)
  appreciationMessages   Int      @default(0)
  exceptionalAssignments Int      @default(0)
  specializedTraining    Boolean  @default(false)
  supportingTraining     Boolean  @default(false)
  languageTraining       Boolean  @default(false)
  softwareTraining       Boolean  @default(false)
  submittedAt            DateTime @default(now())
  submittedById          String?
  employee               Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy            User?    @relation("PersonnelEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model PayrollResult {
  id                     String   @id @default(uuid())
  employeeId             String
  month                  String
  totalHours             Float    @default(0)
  overtime               Float    @default(0)
  absences               Int      @default(0)
  hrPresenceScore        Float?
  hrAbsenceDays          Int      @default(0)
  hrDelayMinutes         Int      @default(0)
  adminScore             Float?
  executiveScore         Float?
  careScore              Float?
  deptPerformance        Float?
  deptDiscipline         Float?
  departmentScore        Float?
  directorLeadership     Float?
  directorImpact         Float?
  directorScore          Float?
  divisionScore          Float?
  gmScore                Float?
  chairmanScore          Float?
  personnelScore         Float?
  personnelDeductionDays Float?
  personnelBonusDays     Float?
  trainingSummary        String?
  finalScore             Float
  finalSalary            Float
  csvGenerated           Boolean  @default(false)
  generatedAt            DateTime @default(now())
  appearance             Float?
  commSkills             Float?
  contDev                Float?
  dataPrivacy            Float?
  hrAnnualPaidLeaves     Int      @default(0)
  hrEmergencyDays        Int      @default(0)
  hrUnpaidLeaves         Int      @default(0)
  orgCompliance          Float?
  pressureHandling       Float?
  probSolving            Float?
  regAdherence           Float?
  regCompliance          Float?
  relColleagues          Float?
  resPreservation        Float?
  safetyAdherence        Float?
  taskQuality            Float?
  teamwork               Float?
  timeCommit             Float?
  workOrg                Float?
  employee               Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, month])
}

model LeaveRequest {
  id                   String    @id @default(uuid())
  employeeId           String
  userId               String
  type                 String
  startDate            DateTime
  endDate              DateTime?
  startTime            String?
  endTime              String?
  reason               String?
  attachmentUrl        String?
  attachmentName       String?
  managerNote          String?
  hrNote               String?
  status               String    @default("PENDING")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deptApprovedById     String?
  divisionApprovedById String?
  directorApprovedById String?
  unitApprovedById     String?
  deptApprovedBy       User?     @relation("LeaveDeptApprovals", fields: [deptApprovedById], references: [id])
  divisionApprovedBy   User?     @relation("LeaveDivisionApprovals", fields: [divisionApprovedById], references: [id])
  directorApprovedBy   User?     @relation("LeaveDirApprovals", fields: [directorApprovedById], references: [id])
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitApprovedBy       User?     @relation("LeaveUnitApprovals", fields: [unitApprovedById], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([userId])
  @@index([status])
}

model StaffTask {
  id           String      @id @default(uuid())
  authorId     String?
  assigneeId   String?
  departmentId String?
  title        String
  content      String?
  deadline     DateTime?
  priority     String      @default("NORMAL")
  status       String      @default("PENDING")
  category     String      @default("ASSIGNED") // "ASSIGNED" or "SELF_REPORT"
  isReviewed   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assignee     User?       @relation("TasksAssignedTo", fields: [assigneeId], references: [id])
  author       User?       @relation("TasksAuthoredBy", fields: [authorId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([category])
}

model Announcement {
  id             String    @id @default(uuid())
  authorId       String?
  targetType     String
  targetId       String?
  title          String
  content        String
  attachmentUrl  String?
  attachmentName String?
  expiryDate     DateTime?
  createdAt      DateTime  @default(now())
  author         User?     @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AssetRequest {
  id          String   @id @default(uuid())
  employeeId  String
  requesterId String
  itemType    String
  status      String   @default("PENDING")
  priority    String   @default("NORMAL")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requester   User     @relation("AssetRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model SupportTicket {
  id          String   @id @default(uuid())
  requesterId String
  title       String
  description String
  category    String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   User     @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assigneeId        String?
  assignee          User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  estimatedReadyAt  DateTime?

  @@index([requesterId])
  @@index([status])
  @@index([assigneeId])
}

model RecruitmentRequest {
  id               String     @id @default(uuid())
  requesterId      String
  unitId           String?
  departmentId     String?
  divisionId       String?
  jobTitle         String
  reason           String?
  type             String     @default("HIRE") // HIRE | JD_CHANGE
  jobDescriptionId String?
  jdPayload        Json?
  quantity         Int        @default(1) // number of people to hire under this requisition
  filled           Boolean    @default(false)
  filledAt         DateTime?
  status           String     @default("PENDING")
  hrNote           String?
  gmNote           String?
  hrApprovedById   String?
  gmApprovedById   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deptApprovedById String?
  deptNote         String?
  deptApprovedAt   DateTime?
  hrApprovedAt     DateTime?
  gmApprovedAt     DateTime?
  department       Department?     @relation(fields: [departmentId], references: [id])
  division         Division?       @relation(fields: [divisionId], references: [id])
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])
  deptApprovedBy   User?      @relation("RecruitmentDeptApproval", fields: [deptApprovedById], references: [id])
  gmApprovedBy     User?      @relation("RecruitmentGMApproval", fields: [gmApprovedById], references: [id])
  hrApprovedBy     User?      @relation("RecruitmentHRApproval", fields: [hrApprovedById], references: [id])
  requester        User       @relation("RecruitmentRequester", fields: [requesterId], references: [id])
  unit             Unit?      @relation(fields: [unitId], references: [id])
  candidates       Candidate[]

  @@index([status])
  @@index([type])
}

// A candidate sourced by HR against an approved HIRE requisition, moving through the hiring pipeline:
// SCREENING (head accept/reject) -> INTERVIEW (schedule + HR & technical evaluations + final decision)
// -> OFFER (candidate accepts/declines the offer) -> HIRED (enrolled as an employee) | REJECTED | WITHDRAWN.
model Candidate {
  id            String    @id @default(uuid())
  requisitionId String
  fullName      String
  phone         String?
  email         String?
  cvPath        String?

  // Application profile captured when the candidate is added
  source            String?   // where the candidate came from (referral / agency / job board...)
  degreePath        String?   // uploaded degree certificate
  portfolioPath     String?   // uploaded portfolio (designers only)
  speciality        String?   // graduation certificate name / speciality
  yearsExperience   String?   // years of relevant work experience
  salaryExpectation String?   // salary expectations
  nationality       String?
  dateOfBirth       DateTime?
  placeOfLiving     String?

  stage         String    @default("SCREENING") // SCREENING | INTERVIEW | OFFER | HIRED | REJECTED | WITHDRAWN

  // Screening — the requesting head accepts or rejects the candidate
  screenDecision String?  // ACCEPTED | REJECTED
  screenNote     String?
  screenById     String?
  screenAt       DateTime?

  // Interview scheduling
  interviewAt       DateTime?
  interviewLocation String?
  interviewNote     String?

  // HR evaluation (score 1-5 + recommendation). hrScore is the overall (average of hrCriteria).
  hrScore     Int?
  hrRecommend Boolean?
  hrNote      String?
  hrCriteria  Json?    // { englishProficiency, motivation, culturalFit, communication, professionalism } each 1-5
  hrEvalById  String?
  hrEvalAt    DateTime?

  // Technical evaluation by the requesting head. techScore is the overall (average of techCriteria).
  techScore     Int?
  techRecommend Boolean?
  techNote      String?
  techCriteria  Json?  // { technicalKnowledge, problemSolving, relevantExperience, softwareProficiency, learningAdaptability } each 1-5
  techEvalById  String?
  techEvalAt    DateTime?

  // Final decision after both evaluations
  finalDecision String?  // ACCEPTED | REJECTED
  finalNote     String?

  // Offer / onboarding — the candidate's response to the offer
  offerDecision String?  // ACCEPTED | DECLINED
  offerNote     String?
  offerAt       DateTime?

  // Job-offer parameters captured up front (on the hiring list) and reused to generate the offer
  salaryStructure String?  // e.g. SS-01-LYD
  jobGrade        String?  // experience-derived grade: Trainee | Intern | Junior | Lead | Senior
  placeOfWork     String?  // chosen from the job description's work locations
  contractMonths  Int?     // 3 or 6
  residentStatus  String?  // RESDANT | DIRCT NONE RESDANT | NONE RESDANT (maps to the employee contract type)

  // Stamped when HR generates the candidate's job-offer document
  offerGeneratedAt DateTime?

  // Set once the accepted candidate is enrolled as an employee
  employeeId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requisition RecruitmentRequest @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CandidateCreator", fields: [createdById], references: [id])
  screenBy    User?              @relation("CandidateScreener", fields: [screenById], references: [id])
  hrEvalBy    User?              @relation("CandidateHrEvaluator", fields: [hrEvalById], references: [id])
  techEvalBy  User?              @relation("CandidateTechEvaluator", fields: [techEvalById], references: [id])

  @@index([requisitionId])
  @@index([stage])
}

model DivisionEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
  submittedById    String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("DivisionEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

