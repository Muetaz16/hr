generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model (System Access)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  fullName      String?
  role          String // SUPER_ADMIN, HEAD_DIRECTOR, HEAD_DEPARTMENT, HEAD_UNIT, HR_MANAGER, EMPLOYEE, PERSONNEL
  departmentId  String?
  unitId        String?
  departmentIds String[] @default([])
  groupId       String?
  createdAt     DateTime @default(now())

  // Relations
  enabledPeriods       EvaluationPeriod[]
  hrEvaluations        HREvaluation[]         @relation("HREvaluationsSubmittedBy")
  unitEvaluations      UnitEvaluation[]       @relation("UnitEvaluationsSubmittedBy")
  deptEvaluations      DepartmentEvaluation[] @relation("DeptEvaluationsSubmittedBy")
  directorEvaluations  DirectorEvaluation[]   @relation("DirectorEvaluationsSubmittedBy")
  personnelEvaluations PersonnelEvaluation[]  @relation("PersonnelEvaluationsSubmittedBy")

  // Staff Hub Relations
  leaveRequests       LeaveRequest[]
  leaveUnitApprovals  LeaveRequest[] @relation("LeaveUnitApprovals")
  leaveDeptApprovals  LeaveRequest[] @relation("LeaveDeptApprovals")
  leaveDirApprovals   LeaveRequest[] @relation("LeaveDirApprovals")
  authoredTasks       StaffTask[]    @relation("TasksAuthoredBy")
  assignedTasks       StaffTask[]    @relation("TasksAssignedTo")
  announcements Announcement[]
  notifications Notification[]

  // Linked HR Record
  employee Employee?
}

// Group Model (Holdings/Subsidiaries)
model Group {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
}

// Department Model
model Department {
  id                String             @id @default(uuid())
  name              String
  groupId           String?
  units             Unit[]
  employees         Employee[]
  evaluationPeriods EvaluationPeriod[]
  StaffTask         StaffTask[]
}

// Unit Model
model Unit {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  employees    Employee[]

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// Employee Model (HR Records)
model Employee {
  id           String   @id @default(uuid())
  fullName     String
  email        String?  @unique
  role         String   @default("EMPLOYEE")
  departmentId String?
  unitId       String?
  groupId      String
  baseSalary   Float    @default(0)
  joinDate     DateTime
  staffId      String?
  position     String?
  fullNameArabic String?
  passportNumber String?
  contractNumber String? // e.g., "1st", "2nd"
  nationality    String?
  jobCategory    String?
  jobGrade       String?

  department Department? @relation(fields: [departmentId], references: [id])
  unit       Unit?      @relation(fields: [unitId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?    @unique

  // Contract Details
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractType      String? // e.g., "Limited", "Unlimited"
  contractStatus    String? // e.g., "Active", "Expired", "Under Renewal"
  holidaysUsed      Float     @default(0)
  emergencyHolidaysUsed Float @default(0)
  unpaidHolidaysUsed    Float     @default(0)
  bonusHolidays     Float     @default(0)

  timeRecords           TimeRecord[]
  hrEvaluations         HREvaluation[]
  unitEvaluations       UnitEvaluation[]
  departmentEvaluations DepartmentEvaluation[]
  directorEvaluations   DirectorEvaluation[]
  personnelEvaluations  PersonnelEvaluation[]
  payrollResults        PayrollResult[]
  leaveRequests         LeaveRequest[]
}

// Evaluation Period Control
model EvaluationPeriod {
  id           String   @id @default(uuid())
  month        String // YYYY-MM
  departmentId String?
  enabled      Boolean  @default(false)
  enabledById  String?
  enabledAt    DateTime @default(now())
  notes        String?

  department Department? @relation(fields: [departmentId], references: [id])
  enabledBy  User?       @relation(fields: [enabledById], references: [id], onDelete: SetNull)
}

// Time Records
model TimeRecord {
  id            String   @id @default(uuid())
  employeeId    String
  month         String
  assignedHours Float    @default(0)
  workedHours   Float    @default(0)
  overtimeHours Float    @default(0)
  absences      Int      @default(0)
  lateMinutes   Int      @default(0)
  status        String   @default("draft")
  updatedAt     DateTime @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// HR Evaluations
model HREvaluation {
  id         String @id @default(uuid())
  employeeId String
  month      String

  // Metrics
  absenceUnauthorized Int @default(0)
  delayMinutes        Int @default(0)
  emergencyLeaves     Int @default(0)
  unpaidLeaves        Int @default(0)
  annualPaidLeaves    Int @default(0)

  // Scores
  absenceScore   Float?
  delayScore     Float?
  emergencyScore Float?
  unpaidScore    Float?
  violationScore Float?

  presenceScore Float?

  status        String    @default("draft")
  submittedAt   DateTime?
  submittedById String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation(name: "HREvaluationsSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

// Unit Evaluations (Professional Eval Tier 1)
model UnitEvaluation {
  id         String @id @default(uuid())
  employeeId String
  month      String

  // 16 Criteria Fields
  relColleagues Float?
  teamwork      Float?
  workOrg       Float?
  commSkills    Float?
  regCompliance Float?

  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?

  regAdherence    Float?
  safetyAdherence Float?
  appearance      Float?
  resPreservation Float?
  dataPrivacy     Float?

  totalScore    Float?
  comments      String?
  submittedAt   DateTime?
  submittedById String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation(name: "UnitEvaluationsSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

// Department Evaluations
model DepartmentEvaluation {
  id         String @id @default(uuid())
  employeeId String
  month      String

  // 16 Criteria Fields
  relColleagues Float?
  teamwork      Float?
  workOrg       Float?
  commSkills    Float?
  regCompliance Float?

  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?

  regAdherence    Float?
  safetyAdherence Float?
  appearance      Float?
  resPreservation Float?
  dataPrivacy     Float?

  totalScore    Float?
  comments      String?
  submittedAt   DateTime?
  submittedById String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation(name: "DeptEvaluationsSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

// Director Evaluations (Final Approval)
model DirectorEvaluation {
  id         String @id @default(uuid())
  employeeId String
  month      String

  // 16 Criteria Fields (Same as Dept)
  relColleagues Float?
  teamwork      Float?
  workOrg       Float?
  commSkills    Float?
  regCompliance Float?

  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?

  regAdherence    Float?
  safetyAdherence Float?
  appearance      Float?
  resPreservation Float?
  dataPrivacy     Float?

  finalScore Float?

  locked        Boolean   @default(false)
  lockedAt      DateTime?
  submittedById String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation(name: "DirectorEvaluationsSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

// Personnel Evaluations (HR/Admin)
model PersonnelEvaluation {
  id         String @id @default(uuid())
  employeeId String
  month      String

  // Activity & Discipline
  warningMessages        Int @default(0)
  disciplinaryDeduction  Int @default(0)
  appreciationMessages   Int @default(0)
  exceptionalAssignments Int @default(0)

  // Training (Booleans)
  specializedTraining Boolean @default(false)
  supportingTraining  Boolean @default(false)
  languageTraining    Boolean @default(false)
  softwareTraining    Boolean @default(false)

  submittedAt   DateTime @default(now())
  submittedById String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation(name: "PersonnelEvaluationsSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

// Payroll Results (Final Report)
model PayrollResult {
  id         String @id @default(uuid())
  employeeId String
  month      String // YYYY-MM

  // Time & Attendance
  totalHours Float @default(0)
  overtime   Float @default(0)
  absences   Int   @default(0)

  // HR Metrics
  hrPresenceScore    Float?
  hrAbsenceDays      Int    @default(0)
  hrDelayMinutes     Int    @default(0)
  hrEmergencyDays    Int    @default(0)
  hrUnpaidLeaves     Int    @default(0)
  hrAnnualPaidLeaves Int    @default(0)

  // Category Scores
  adminScore    Float?
  relColleagues Float?
  teamwork      Float?
  workOrg       Float?
  commSkills    Float?
  regCompliance Float?

  executiveScore   Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?

  careScore       Float?
  regAdherence    Float?
  safetyAdherence Float?
  appearance      Float?
  resPreservation Float?
  dataPrivacy     Float?

  // Legacy/Aggregate
  deptPerformance    Float?
  deptDiscipline     Float?
  departmentScore    Float?
  directorLeadership Float? // Deprecated/Placeholder
  directorImpact     Float? // Deprecated/Placeholder
  directorScore      Float?

  // Personnel Metrics
  personnelScore         Float?
  personnelDeductionDays Float?
  personnelBonusDays     Float?
  trainingSummary        String?

  // Final
  finalScore  Float
  finalSalary Float

  csvGenerated Boolean  @default(false)
  generatedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Staff Hub: Leave & Permission Requests
model LeaveRequest {
  id          String    @id @default(uuid())
  employeeId  String
  userId      String // The requesting user (usually the employee's user account)
  type        String // LATE_COMING, EARLY_LEAVING, HOURS_LEAVE, PAID_HOLIDAY, UNPAID_LEAVE, EMERGENCY_LEAVE
  startDate   DateTime
  endDate     DateTime?
  startTime   String? // For hour-based requests
  endTime     String? // For hour-based requests
  reason             String?
  managerNote        String?
  hrNote             String?
  status             String    @default("PENDING") // PENDING, APPROVED_BY_UNIT, APPROVED_BY_DEPT, REJECTED, COMPLETED
  unitApprovedById   String?
  deptApprovedById   String?
  directorApprovedById String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitApprovedBy  User?  @relation(name: "LeaveUnitApprovals", fields: [unitApprovedById], references: [id], onDelete: SetNull)
  deptApprovedBy  User?  @relation(name: "LeaveDeptApprovals", fields: [deptApprovedById], references: [id], onDelete: SetNull)
  directorApprovedBy User? @relation(name: "LeaveDirApprovals", fields: [directorApprovedById], references: [id], onDelete: SetNull)
}

// Staff Hub: Task Management
model StaffTask {
  id           String    @id @default(uuid())
  authorId     String? // Who assigned the task
  assigneeId   String? // Specific employee
  departmentId String? // Assigned to whole department
  title        String
  content      String?
  deadline     DateTime?
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author     User?       @relation("TasksAuthoredBy", fields: [authorId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TasksAssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id])
}

// Staff Hub: Announcements
model Announcement {
  id         String    @id @default(uuid())
  authorId   String?
  targetType String // GLOBAL, DEPARTMENT, INDIVIDUAL
  targetId   String? // DeptId or UserId or null if Global
  title      String
  content    String
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// System Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
