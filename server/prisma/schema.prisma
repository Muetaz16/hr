  unitId           String?
  departmentId     String?
  divisionId       String?
  jobTitle         String
  reason           String?
  type             String     @default("HIRE") // HIRE | JD_CHANGE
  jobDescriptionId String?
  jdPayload        Json?
  quantity         Int        @default(1) // number of people to hire under this requisition
  filled           Boolean    @default(false)
  filledAt         DateTime?
  // Careers portal: auto-published when a HIRE requisition is fully approved,
  // auto-removed when the position is marked filled.
  publishedToCareers Boolean  @default(false)
  publishedAt        DateTime?
  status           String     @default("PENDING")
  hrNote           String?
  gmNote           String?
  hrApprovedById   String?
  gmApprovedById   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deptApprovedById String?
  deptNote         String?
  deptApprovedAt   DateTime?
  hrApprovedAt     DateTime?
  gmApprovedAt     DateTime?
  // Personnel Requisition Form (PRF) extra fields captured on a HIRE request.
  reportsTo        String?   // reports-to, written by the requester
  employmentType   String?   // نوع التعيين — e.g. Full-time / Part-time / Contract
  typeOfRequest    String?   // نوع الطلب — e.g. New Position / Replacement
  languageEn       String?   // English language requirement level
  languageAr       String?   // Arabic language requirement level
  // Snapshot of each PRF approval stage: { deptHead|divHead|hrManager|hrRecruitment|gm: { byId, byName, signature, at, note } }
  prfApprovals     Json?
  department       Department?     @relation(fields: [departmentId], references: [id])
  division         Division?       @relation(fields: [divisionId], references: [id])
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])
  deptApprovedBy   User?      @relation("RecruitmentDeptApproval", fields: [deptApprovedById], references: [id])
  gmApprovedBy     User?      @relation("RecruitmentGMApproval", fields: [gmApprovedById], references: [id])
  hrApprovedBy     User?      @relation("RecruitmentHRApproval", fields: [hrApprovedById], references: [id])
  requester        User       @relation("RecruitmentRequester", fields: [requesterId], references: [id])
  unit             Unit?      @relation(fields: [unitId], references: [id])
  candidates       Candidate[]

  @@index([status])
  @@index([type])
  @@index([publishedToCareers, filled])
}

// A candidate sourced by HR against an approved HIRE requisition, moving through the hiring pipeline:
// SCREENING (head accept/reject) -> INTERVIEW (schedule + HR & technical evaluations + final decision)
// -> OFFER (candidate accepts/declines the offer) -> HIRED (enrolled as an employee) | REJECTED | WITHDRAWN.
model Candidate {
  id            String    @id @default(uuid())
  requisitionId String
  fullName      String
  phone         String?
  email         String?
  cvPath        String?

  // Application profile captured when the candidate is added
  source            String?   // where the candidate came from (referral / agency / job board...)
  appliedViaCareers Boolean   @default(false) // submitted through the public careers portal
  degreePath        String?   // uploaded degree certificate
  portfolioPath     String?   // uploaded portfolio (designers only)
  speciality        String?   // graduation certificate name / speciality (degree course)
  educationLevel    String?   // highest education level (High School / Bachelor's / Master's ...)
  yearsExperience   String?   // years of relevant work experience
  salaryExpectation String?   // salary expectations
  nationality       String?
  dateOfBirth       DateTime?
  placeOfLiving     String?

  stage         String    @default("SCREENING") // SCREENING | INTERVIEW | OFFER | HIRED | REJECTED | WITHDRAWN

  // Self-service onboarding: HR generates a private link; the new hire fills their own data.
  onboardingToken       String?   @unique // unguessable token embedded in the onboarding link
  onboardingStatus      String?   // PENDING | SUBMITTED | ENROLLED
  onboardingData        Json?     // the identity/bank/document data the hire submitted
  onboardingSubmittedAt DateTime?

  // Screening — the requesting head accepts or rejects the candidate
  screenDecision String?  // ACCEPTED | REJECTED
  screenNote     String?
  screenById     String?
  screenAt       DateTime?

  // Interview scheduling
  interviewAt       DateTime?
  interviewLocation String?
  interviewNote     String?

  // HR evaluation (score 1-5 + recommendation). hrScore is the overall (average of hrCriteria).
  hrScore     Int?
  hrRecommend Boolean?
  hrNote      String?
  hrCriteria  Json?    // { englishProficiency, motivation, culturalFit, communication, professionalism } each 1-5
  hrEvalById  String?
  hrEvalAt    DateTime?

  // Technical evaluation by the requesting head. techScore is the overall (average of techCriteria).
  techScore     Int?
  techRecommend Boolean?
  techNote      String?
  techCriteria  Json?  // { technicalKnowledge, problemSolving, relevantExperience, softwareProficiency, learningAdaptability } each 1-5
  techEvalById  String?
  techEvalAt    DateTime?

  // Final decision after both evaluations
  finalDecision String?  // ACCEPTED | REJECTED
  finalNote     String?

  // Offer / onboarding — the candidate's response to the offer
  offerDecision String?  // ACCEPTED | DECLINED
  offerNote     String?
  offerAt       DateTime?

  // Job-offer parameters captured up front (on the hiring list) and reused to generate the offer
  salaryStructure String?  // e.g. SS-01-LYD
  jobGrade        String?  // experience-derived grade: Trainee | Intern | Junior | Lead | Senior
  jobCategory     String?  // derived from Job Description
  placeOfWork     String?  // chosen from the job description's work locations
  contractMonths  Int?     // 3 or 6
  residentStatus  String?  // RESDANT | DIRCT NONE RESDANT | NONE RESDANT (maps to the employee contract type)

  // Stamped when HR generates the candidate's job-offer document
  offerGeneratedAt DateTime?

  // Set once the accepted candidate is enrolled as an employee
  employeeId String?

  events      Json?    @default("[]") // Array of event objects: { action, performedBy, timestamp, note }

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requisition RecruitmentRequest @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CandidateCreator", fields: [createdById], references: [id])
  screenBy    User?              @relation("CandidateScreener", fields: [screenById], references: [id])
  hrEvalBy    User?              @relation("CandidateHrEvaluator", fields: [hrEvalById], references: [id])
  techEvalBy  User?              @relation("CandidateTechEvaluator", fields: [techEvalById], references: [id])

  @@index([requisitionId])
  @@index([stage])
}

model DivisionEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
