  adminScore             Float?
  executiveScore         Float?
  careScore              Float?
  deptPerformance        Float?
  deptDiscipline         Float?
  departmentScore        Float?
  directorLeadership     Float?
  directorImpact         Float?
  directorScore          Float?
  divisionScore          Float?
  gmScore                Float?
  chairmanScore          Float?
  personnelScore         Float?
  personnelDeductionDays Float?
  personnelBonusDays     Float?
  exceptionalScore       Float?
  trainingScore          Float?
  trainingSummary        String?
  finalScore             Float
  finalSalary            Float
  csvGenerated           Boolean  @default(false)
  generatedAt            DateTime @default(now())
  appearance             Float?
  commSkills             Float?
  contDev                Float?
  dataPrivacy            Float?
  hrAnnualPaidLeaves     Int      @default(0)
  hrEmergencyDays        Int      @default(0)
  hrUnpaidLeaves         Int      @default(0)
  orgCompliance          Float?
  pressureHandling       Float?
  probSolving            Float?
  regAdherence           Float?
  regCompliance          Float?
  relColleagues          Float?
  resPreservation        Float?
  safetyAdherence        Float?
  taskQuality            Float?
  teamwork               Float?
  timeCommit             Float?
  workOrg                Float?
