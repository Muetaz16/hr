generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid())
  email                    String                 @unique
  password                 String
  fullName                 String?
  role                     String
  departmentId             String?
  groupId                  String?
  createdAt                DateTime               @default(now())
  departmentIds            String[]               @default([])
  unitId                   String?
  divisionId               String?                // the division a HEAD_DIVISION owns (drives leave-approval routing for all its departments)
  permissions              String[]               @default([])
  signature                String?
  announcements            Announcement[]
  requestedAssets          AssetRequest[]         @relation("AssetRequester")
  deptEvaluations          DepartmentEvaluation[] @relation("DeptEvaluationsSubmittedBy")
  directorEvaluations      DirectorEvaluation[]   @relation("DirectorEvaluationsSubmittedBy")
  divisionEvaluations      DivisionEvaluation[]   @relation("DivisionEvaluationsSubmittedBy")
  gmEvaluations            GMEvaluation[]         @relation("GMEvaluationsSubmittedBy")
  chairmanEvaluations      ChairmanEvaluation[]   @relation("ChairmanEvaluationsSubmittedBy")
  employee                 Employee?
  enabledPeriods           EvaluationPeriod[]     @relation("EvaluationPeriodEnabledBy")
  disabledPeriods          EvaluationPeriod[]     @relation("EvaluationPeriodDisabledBy")
  evaluationFinalizations  EvaluationFinalization[] @relation("EvaluationFinalizationsFinalizedBy")
  hrEvaluations            HREvaluation[]         @relation("HREvaluationsSubmittedBy")
  leaveDeptApprovals       LeaveRequest[]         @relation("LeaveDeptApprovals")
  leaveDivisionApprovals   LeaveRequest[]         @relation("LeaveDivisionApprovals")
  leaveDirApprovals        LeaveRequest[]         @relation("LeaveDirApprovals")
  leaveUnitApprovals       LeaveRequest[]         @relation("LeaveUnitApprovals")
  leaveRequests            LeaveRequest[]
  leaveApprovalSteps       LeaveApprovalStep[]    @relation("LeaveApprovalStepApprover")
  notifications            Notification[]
  personnelEvaluations     PersonnelEvaluation[]  @relation("PersonnelEvaluationsSubmittedBy")
  deptRecruitmentApprovals RecruitmentRequest[]   @relation("RecruitmentDeptApproval")
  gmRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentGMApproval")
  hrRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentHRApproval")
  recruitmentRequests      RecruitmentRequest[]   @relation("RecruitmentRequester")
  candidatesCreated        Candidate[]            @relation("CandidateCreator")
  candidatesScreened       Candidate[]            @relation("CandidateScreener")
  candidatesHrEvaluated    Candidate[]            @relation("CandidateHrEvaluator")
  candidatesTechEvaluated  Candidate[]            @relation("CandidateTechEvaluator")
  assignedTasks            StaffTask[]            @relation("TasksAssignedTo")
  authoredTasks            StaffTask[]            @relation("TasksAuthoredBy")
  supportTickets           SupportTicket[]        @relation("TicketRequester")
  assignedSupportTickets   SupportTicket[]        @relation("TicketAssignee")
  unitEvaluations          UnitEvaluation[]       @relation("UnitEvaluationsSubmittedBy")
}

model Group {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
}

model Department {
  id                  String               @id @default(uuid())
  name                String
  groupId             String?
  employees           Employee[]
  evaluationPeriods   EvaluationPeriod[]
  recruitmentRequests RecruitmentRequest[]
  StaffTask           StaffTask[]
  units               Unit[]
  divisionId          String?
  isOffice            Boolean              @default(false)
  positionFactor      Float                @default(1.0)
  division            Division?            @relation(fields: [divisionId], references: [id])
  jobDescriptions     JobDescription[]
}

model Directorate {
  id          String       @id @default(uuid())
  name        String
  divisions   Division[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  positionFactor Float     @default(1.0)
  jobDescriptions JobDescription[]
}

model Division {
  id                  String               @id @default(uuid())
  name                String
  directorateId       String?
  directorate         Directorate?         @relation(fields: [directorateId], references: [id])
  departments         Department[]
  employees           Employee[]
  positionFactor      Float                @default(1.0)
  jobDescriptions     JobDescription[]
  recruitmentRequests RecruitmentRequest[]
}

model Unit {
  id                  String               @id @default(uuid())
  name                String
  departmentId        String
  headcount           Int                  @default(0)
  employees           Employee[]
  recruitmentRequests RecruitmentRequest[]
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobDescriptions     JobDescription[]
}

model JobDescription {
  id             String       @id @default(uuid())
  title          String
  description    String?
  isHead         Boolean      @default(false)
  plannedCount   Int          @default(1)
  jobCategories  String[]     @default([])
  workLocations  String[]     @default([])
  details        Json?
  directorateId  String?
  divisionId     String?
  departmentId   String?
  unitId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  directorate    Directorate? @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  division       Division?    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees      Employee[]
  recruitmentRequests RecruitmentRequest[]

  @@index([directorateId])
  @@index([divisionId])
  @@index([departmentId])
  @@index([unitId])
}

model Employee {
  id                     String                 @id @default(uuid())
  fullName               String
  email                  String?                @unique
  role                   String                 @default("EMPLOYEE")
  // "ACTIVE" for fully-enrolled employees; "PENDING_ENROLLMENT" for stubs imported from BioTime
  // that still need a Job Description / role / department (and a login account) assigned by HR.
  // Pending employees are excluded from payroll and evaluation lists until enrollment completes.
  enrollmentStatus       String                 @default("ACTIVE")
  departmentId           String?
  groupId                String?
  baseSalary             Float                  @default(0)
  joinDate               DateTime
  staffId                String?
  bioId                  Int?
  contractEndDate        DateTime?
  contractStartDate      DateTime?
  contractStatus         String?
  contractType           String?
  holidaysUsed           Float                  @default(0)
  bonusHolidays          Float                  @default(0)
  userId                 String?                @unique
  unitId                 String?
  position               String?
  placeOfWork            String?
  contractNumber         String?
  emergencyHolidaysUsed  Float                  @default(0)
  fullNameArabic         String?
  jobCategory            String?
  jobGrade               String?
  salaryStructureType    String?
  nationality            String?
  passportNumber         String?
  unpaidHolidaysUsed     Float                  @default(0)
  positionFactor         Float                  @default(1.0)
  siteFactor             Float                  @default(1.0)
  skillFactor            Float                  @default(1.0)
  languageFactor         Float                  @default(1.0)
  evaluationPoints       Float                  @default(0)
  promotionNotified      Boolean                @default(false)
  // --- Extended Identity Details (recruitment intake form) ---
  dateOfBirth                DateTime?
  placeOfBirth               String?
  nationalId                 String?
  academicQualification      String?
  gender                     String?
  bloodType                  String?
  idCardNumber               String?
  idPlaceOfIssue             String?
  idIssueDate                DateTime?
  passportPlaceOfIssue       String?
  passportExpiryDate         DateTime?
  drivingLicenseType         String?
  drivingLicenseNumber       String?
  drivingLicenseExpiry       DateTime?
  drivingLicensePlaceOfIssue String?
  personalPhone              String?
  personalEmail              String?
  emergencyContactNumber     String?
  residentialAddress         String?
  workedBefore               String?
  hasRelativesInCompany      String?
  relativesNames             String?
  bankName                   String?
  bankBranchName             String?
  bankAccountNumber          String?
  arrivalDate                DateTime?
  cvUrl                      String?
  degreeUrl                  String?
  birthCertUrl               String?
  passportCopyUrl            String?
  bankCheckUrl               String?
  photoUrl                   String?
  idCardUrl                  String?
  jobOfferUrl                String?
  healthCertUrl              String?
  // --- Arabic counterparts of the bilingual onboarding fields ---
  placeOfBirthArabic               String?
  nationalityArabic                String?
  academicQualificationArabic      String?
  idPlaceOfIssueArabic             String?
  passportPlaceOfIssueArabic       String?
  drivingLicenseTypeArabic         String?
  drivingLicensePlaceOfIssueArabic String?
  residentialAddressArabic         String?
  relativesNamesArabic             String?
  bankNameArabic                   String?
  bankBranchNameArabic             String?
  // --- Onboarding-only fields (self-service onboarding form) ---
  // NOTE: department, job category/level and hourly rate are NOT stored here — they're assigned
  // by the recruitment team on the Candidate (before the offer), not self-reported by the hire.
  serviceProviderCompany String? // Service Provider onboarding: the supplying company's name
  employeeTravelDate    DateTime? // Service Provider onboarding: travel date
  employeeStartDate     DateTime? // date the hire indicates they can start (from onboarding)
  ticketUrl             String? // Non-Resident / Service Provider onboarding: airplane ticket
  residencyDocumentUrl  String? // Non-Resident / Service Provider onboarding: residency document
  interviewEvaluationUrl String? // Service Provider onboarding: interview evaluation form
  jobDescriptionId       String?
  jobDescription         JobDescription?        @relation(fields: [jobDescriptionId], references: [id])
  assetRequests          AssetRequest[]
  contracts              Contract[]
  documents              EmployeeDocument[]
  personnelActionForms   PersonnelActionForm[]
  departmentEvaluations  DepartmentEvaluation[]
  directorEvaluations    DirectorEvaluation[]
  divisionEvaluations    DivisionEvaluation[]
  gmEvaluations          GMEvaluation[]
  chairmanEvaluations    ChairmanEvaluation[]
  divisionId             String?
  directorateId          String?
  directorate            Directorate?           @relation(fields: [directorateId], references: [id])
  division               Division?              @relation(fields: [divisionId], references: [id])
  department             Department?            @relation(fields: [departmentId], references: [id])
  group                  Group?                 @relation(fields: [groupId], references: [id])
  unit                   Unit?                  @relation(fields: [unitId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  hrEvaluations          HREvaluation[]
  leaveRequests          LeaveRequest[]
  payrollResults         PayrollResult[]
  personnelEvaluations   PersonnelEvaluation[]
  timeRecords            TimeRecord[]
  unitEvaluations        UnitEvaluation[]
  evaluationFinalizations EvaluationFinalization[]

  @@index([departmentId])
  @@index([unitId])
  @@index([groupId])
  @@index([jobDescriptionId])
  @@index([bioId])
}

// Free-form documents attached to an employee beyond the fixed onboarding slots (CV, degree,
// etc.) — e.g. a new certificate, a promotion letter, or any other file HR wants on file. Also
// used to log an update to one of the fixed slots, but those are still stored on Employee itself.
model EmployeeDocument {
  id             String   @id @default(uuid())
  employeeId     String
  name           String // HR-chosen label, e.g. "Training Certificate"
  fileUrl        String
  fileName       String? // original uploaded filename, for display
  uploadedByName String?
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Personnel Action Form (PAF) — an internal transfer. HR picks the target Job Description (which
// defines the destination division/department/unit/position/category); the DOCX is generated for
// physical signatures, the signed copy is uploaded, then on Accept the employee is moved into that
// JD and the signed form is filed under their Lifecycle documents. `current*` snapshots the
// placement at creation for the document + audit; `new*` mirrors the target JD's placement.
model PersonnelActionForm {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  actionType          String    @default("TRANSFER")
  status              String    @default("PENDING") // PENDING | ACCEPTED | REJECTED

  currentDivision     String?
  currentDepartment   String?
  currentUnit         String?
  currentPosition     String?
  currentJobCategory  String?
  currentJobGrade     String?
  currentPlaceOfWork  String?

  newJobDescriptionId String? // the target JD that drives the move
  newDivisionId       String?
  newDepartmentId     String?
  newUnitId           String?
  newPositionTitle    String?
  newJobCategory      String?
  newJobGrade         String?
  newPlaceOfWork      String?
  reportsTo           String?

  typeOfTransfer      String?
  effectiveDate       DateTime?
  justification       String?

  documentUrl         String?
  documentName        String?

  createdByName       String?
  decidedByName       String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Contract {
  id                    String    @id @default(uuid())
  employeeId            String
  contractNumber        String?
  startDate             DateTime
  endDate               DateTime?
  type                  String?
  status                String    @default("ACTIVE")
  salary                Float     @default(0)
  notes                 String?
  documentUrl           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  emergencyHolidaysUsed Float     @default(0)
  holidaysUsed          Float     @default(0)
  jobCategory           String?
  jobGrade              String?
  position              String?
  unpaidHolidaysUsed    Float     @default(0)
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EvaluationPeriod {
  id           String      @id @default(uuid())
  month        String
  departmentId String?
  enabled      Boolean     @default(false)
  enabledById  String?
  enabledAt    DateTime    @default(now())
  notes        String?
  // true while this month's period is driven purely by the day-15/day-20 auto
  // open/close schedule; flipped to false the moment HR/SUPER_ADMIN manually
  // enables or disables it, so the daily reconciliation job stops touching it.
  isAutoManaged      Boolean   @default(true)
  disabledById       String?
  disabledAt         DateTime?
  // Idempotency markers so the daily job sends each monthly batch exactly once.
  openNotifiedAt     DateTime?
  reminderNotifiedAt DateTime?
  department   Department? @relation(fields: [departmentId], references: [id])
  enabledBy    User?       @relation("EvaluationPeriodEnabledBy", fields: [enabledById], references: [id])
  disabledBy   User?       @relation("EvaluationPeriodDisabledBy", fields: [disabledById], references: [id])
}

model TimeRecord {
  id            String   @id @default(uuid())
  employeeId    String
  month         String
  assignedHours Float    @default(0)
  workedHours   Float    @default(0)
  overtimeHours Float    @default(0)
  absences      Int      @default(0)
  lateMinutes   Int      @default(0)
  status        String   @default("draft")
  updatedAt     DateTime @default(now()) @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, month])
}

model HREvaluation {
  id                  String    @id @default(uuid())
  employeeId          String
  month               String
  absenceUnauthorized Int       @default(0)
  delayMinutes        Int       @default(0)
  emergencyLeaves     Int       @default(0)
  unpaidLeaves        Int       @default(0)
  annualPaidLeaves    Int       @default(0)
  absenceScore        Float?
  delayScore          Float?
  emergencyScore      Float?
  unpaidScore         Float?
  violationScore      Float?
  presenceScore       Float?
  status              String    @default("draft")
  submittedAt         DateTime?
  submittedById       String?
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy         User?     @relation("HREvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model UnitEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
  submittedById    String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("UnitEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model DepartmentEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  relColleagues    Float?
  teamwork         Float?
  workOrg          Float?
  commSkills       Float?
  regCompliance    Float?
  taskQuality      Float?
  timeCommit       Float?
  orgCompliance    Float?
  probSolving      Float?
  pressureHandling Float?
  contDev          Float?
  regAdherence     Float?
  safetyAdherence  Float?
  appearance       Float?
  resPreservation  Float?
  dataPrivacy      Float?
  totalScore       Float?
  comments         String?
  submittedAt      DateTime?
  submittedById    String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("DeptEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model DirectorEvaluation {
  id               String    @id @default(uuid())
  employeeId       String
  month            String
  finalScore       Float?
  locked           Boolean   @default(false)
  lockedAt         DateTime?
  submittedById    String?
  appearance       Float?
  commSkills       Float?
  contDev          Float?
  dataPrivacy      Float?
  orgCompliance    Float?
  pressureHandling Float?
  probSolving      Float?
  regAdherence     Float?
  regCompliance    Float?
  relColleagues    Float?
  resPreservation  Float?
  safetyAdherence  Float?
  taskQuality      Float?
  teamwork         Float?
  timeCommit       Float?
  workOrg          Float?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy      User?     @relation("DirectorEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

model PersonnelEvaluation {
  id                     String   @id @default(uuid())
  employeeId             String
  month                  String
  warningMessages        Int      @default(0)
  disciplinaryDeduction  Int      @default(0)
  appreciationMessages   Int      @default(0)
  exceptionalAssignments Int      @default(0)
  specializedTraining    Boolean  @default(false)
  supportingTraining     Boolean  @default(false)
  languageTraining       Boolean  @default(false)
  softwareTraining       Boolean  @default(false)
  submittedAt            DateTime @default(now())
  submittedById          String?
  employee               Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy            User?    @relation("PersonnelEvaluationsSubmittedBy", fields: [submittedById], references: [id])

  @@index([employeeId, month])
}

// One row per employee per month, created the moment HR "saves"/finalizes that
// month's evaluation (manually, day 25-30, or automatically once day 30 has
// passed). Its existence is the single source of truth that freezes every
// other evaluation table (HR/Personnel/Unit/Department/Division/Director/GM/
// Chairman) for that employee+month, and is the trigger point for crediting
// Employee.evaluationPoints (the "Evaluation Index") — see
// server/src/utils/evaluationPoints.ts. Never updated once created; the
// @@unique guarantees it can only ever be awarded once per employee per month.
model EvaluationFinalization {
  id            String    @id @default(uuid())
  employeeId    String
  month         String
  finalScore    Float
  finalizedAt   DateTime  @default(now())
  finalizedById String?
  isAuto        Boolean   @default(false)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  finalizedBy   User?     @relation("EvaluationFinalizationsFinalizedBy", fields: [finalizedById], references: [id])

  @@unique([employeeId, month])
}

