generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid())
  email                    String                 @unique
  password                 String
  fullName                 String?
  role                     String
  departmentId             String?
  groupId                  String?
  createdAt                DateTime               @default(now())
  departmentIds            String[]               @default([])
  unitId                   String?
  divisionId               String?                // the division a HEAD_DIVISION owns (drives leave-approval routing for all its departments)
  permissions              String[]               @default([]) // individual permission GRANTS layered on top of position + hats
  functionalHatIds         String[]               @default([]) // FunctionalHat ids the user holds (many); each adds its permissions
  signature                String?
  announcements            Announcement[]
  deptEvaluations          DepartmentEvaluation[] @relation("DeptEvaluationsSubmittedBy")
  directorEvaluations      DirectorEvaluation[]   @relation("DirectorEvaluationsSubmittedBy")
  divisionEvaluations      DivisionEvaluation[]   @relation("DivisionEvaluationsSubmittedBy")
  gmEvaluations            GMEvaluation[]         @relation("GMEvaluationsSubmittedBy")
  chairmanEvaluations      ChairmanEvaluation[]   @relation("ChairmanEvaluationsSubmittedBy")
  employee                 Employee?
  enabledPeriods           EvaluationPeriod[]     @relation("EvaluationPeriodEnabledBy")
  disabledPeriods          EvaluationPeriod[]     @relation("EvaluationPeriodDisabledBy")
  evaluationFinalizations  EvaluationFinalization[] @relation("EvaluationFinalizationsFinalizedBy")
  hrEvaluations            HREvaluation[]         @relation("HREvaluationsSubmittedBy")
  leaveDeptApprovals       LeaveRequest[]         @relation("LeaveDeptApprovals")
  leaveDivisionApprovals   LeaveRequest[]         @relation("LeaveDivisionApprovals")
  leaveDirApprovals        LeaveRequest[]         @relation("LeaveDirApprovals")
  leaveUnitApprovals       LeaveRequest[]         @relation("LeaveUnitApprovals")
  leaveRequests            LeaveRequest[]
  leaveReplacements        LeaveRequest[]         @relation("LeaveReplacement")
  leaveApprovalSteps       LeaveApprovalStep[]    @relation("LeaveApprovalStepApprover")
  notifications            Notification[]
  personnelEvaluations     PersonnelEvaluation[]  @relation("PersonnelEvaluationsSubmittedBy")
  deptRecruitmentApprovals RecruitmentRequest[]   @relation("RecruitmentDeptApproval")
  gmRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentGMApproval")
  hrRecruitmentApprovals   RecruitmentRequest[]   @relation("RecruitmentHRApproval")
  recruitmentRequests      RecruitmentRequest[]   @relation("RecruitmentRequester")
  candidatesCreated        Candidate[]            @relation("CandidateCreator")
  candidatesScreened       Candidate[]            @relation("CandidateScreener")
  candidatesHrEvaluated    Candidate[]            @relation("CandidateHrEvaluator")
  candidatesTechEvaluated  Candidate[]            @relation("CandidateTechEvaluator")
  unitEvaluations          UnitEvaluation[]       @relation("UnitEvaluationsSubmittedBy")
  disciplinaryReports              DisciplinaryCase[]   @relation("DisciplinaryReportedBy")
  disciplinaryIncidentReports      DisciplinaryCase[]   @relation("DisciplinaryIncidentReportCompletedBy")
  disciplinaryNoticesToExplain     DisciplinaryCase[]   @relation("DisciplinaryNoticeToExplainCompletedBy")
  disciplinaryInvestigations       DisciplinaryCase[]   @relation("DisciplinaryInvestigationCompletedBy")
  disciplinaryActionsCompleted     DisciplinaryCase[]   @relation("DisciplinaryActionCompletedBy")
}

model Group {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
}

// Functional "hat" a user can wear independently of their org position. A user
// may hold several at once; each contributes its permissions to the user's
// effective access. System hats (isSystem) are seeded and upserted by key.
model FunctionalHat {
  id          String   @id @default(uuid())
  key         String?  @unique
  name        String
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Department {
  id                  String               @id @default(uuid())
  name                String
  groupId             String?
  employees           Employee[]
  evaluationPeriods   EvaluationPeriod[]
  recruitmentRequests RecruitmentRequest[]
  units               Unit[]
  divisionId          String?
  isOffice            Boolean              @default(false)
  positionFactor      Float                @default(1.0)
  division            Division?            @relation(fields: [divisionId], references: [id])
  jobDescriptions     JobDescription[]
}

model Directorate {
  id          String       @id @default(uuid())
  name        String
  divisions   Division[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  positionFactor Float     @default(1.0)
  jobDescriptions JobDescription[]
}

model Division {
  id                  String               @id @default(uuid())
  name                String
  directorateId       String?
  directorate         Directorate?         @relation(fields: [directorateId], references: [id])
  departments         Department[]
  employees           Employee[]
  positionFactor      Float                @default(1.0)
  jobDescriptions     JobDescription[]
  recruitmentRequests RecruitmentRequest[]
}

model Unit {
  id                  String               @id @default(uuid())
  name                String
  departmentId        String
  headcount           Int                  @default(0)
  employees           Employee[]
  recruitmentRequests RecruitmentRequest[]
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobDescriptions     JobDescription[]
}

model JobDescription {
  id             String       @id @default(uuid())
  title          String
  description    String?
  isHead         Boolean      @default(false)
  plannedCount   Int          @default(1)
  jobCategories  String[]     @default([])
  workLocations  String[]     @default([])
  details        Json?
  directorateId  String?
  divisionId     String?
  departmentId   String?
  unitId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  directorate    Directorate? @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  division       Division?    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employees      Employee[]
  recruitmentRequests RecruitmentRequest[]

  @@index([directorateId])
  @@index([divisionId])
  @@index([departmentId])
  @@index([unitId])
}

model Employee {
  id                     String                 @id @default(uuid())
  fullName               String
  email                  String?                @unique
  role                   String                 @default("EMPLOYEE")
  // "ACTIVE" for fully-enrolled employees; "PENDING_ENROLLMENT" for stubs imported from BioTime
  // that still need a Job Description / role / department (and a login account) assigned by HR;
  // "TRANSFERRED" for staff moved to another company (data retained + visible, but excluded from
  // evaluation, payroll, attendance and active counts).
  // Pending employees are excluded from payroll and evaluation lists until enrollment completes.
  // "SEPARATED" once an OffboardingCase for this employee reaches CLOSED (voluntary resignation or
  // involuntary termination/non-renewal/retrenchment) — excludes them from active-employee views
  // (e.g. disciplinaryController.getAttendanceCandidates already filters on ACTIVE only).
  enrollmentStatus       String                 @default("ACTIVE")
  separationDate         DateTime?
  // Set when an inter-company transfer is accepted: destination company name + date.
  transferredCompany     String?
  transferredAt          DateTime?
  departmentId           String?
  groupId                String?
  joinDate               DateTime
  staffId                String?
  bioId                  Int?
  contractEndDate        DateTime?
  contractStartDate      DateTime?
  contractStatus         String?
  contractType           String?
  contractWorkType       String?                @default("Full Time") // 'Full Time' | 'Part Time'
  holidaysUsed           Float                  @default(0)
  bonusHolidays          Float                  @default(0)
  userId                 String?                @unique
  unitId                 String?
  position               String?
  placeOfWork            String?
  contractNumber         String?
  emergencyHolidaysUsed  Float                  @default(0)
  fullNameArabic         String?
  jobCategory            String?
  jobGrade               String?
  salaryStructureType    String?
  nationality            String?
  passportNumber         String?
  unpaidHolidaysUsed     Float                  @default(0)
  positionFactor         Float                  @default(1.0)
  siteFactor             Float                  @default(1.0)
  skillFactor            Float                  @default(1.0)
  languageFactor         Float                  @default(1.0)
  evaluationPoints       Float                  @default(0)
  promotionNotified      Boolean                @default(false)
  // Set when a PromotionCase closes (or backfilled from contractStartDate/joinDate at migration
  // time) — "how long has this employee been at their CURRENT grade", which neither joinDate
  // (company tenure) nor contractStartDate (can be reset by an unrelated renewal) reliably tracks.
  // Drives the Trainee/Intern tenure-based promotion eligibility checks.
  currentGradeSince      DateTime?
  promotionCases         PromotionCase[]
  rewardCases            RewardCase[]
  // --- Extended Identity Details (recruitment intake form) ---
  dateOfBirth                DateTime?
  placeOfBirth               String?
  nationalId                 String?
  academicQualification      String?
  gender                     String?
  bloodType                  String?
  idCardNumber               String?
  idPlaceOfIssue             String?
  idIssueDate                DateTime?
  passportPlaceOfIssue       String?
  passportExpiryDate         DateTime?
  drivingLicenseType         String?
  drivingLicenseNumber       String?
  drivingLicenseExpiry       DateTime?
  drivingLicensePlaceOfIssue String?
  personalPhone              String?
  personalEmail              String?
  emergencyContactNumber     String?
  residentialAddress         String?
  workedBefore               String?
  hasRelativesInCompany      String?
  relativesNames             String?
  bankName                   String?
  bankBranchName             String?
  bankAccountNumber          String?
  arrivalDate                DateTime?
  cvUrl                      String?
  degreeUrl                  String?
  birthCertUrl               String?
  passportCopyUrl            String?
  bankCheckUrl               String?
  photoUrl                   String?
  idCardUrl                  String?
  jobOfferUrl                String?
  healthCertUrl              String?
  // --- Arabic counterparts of the bilingual onboarding fields ---
  placeOfBirthArabic               String?
  nationalityArabic                String?
  academicQualificationArabic      String?
  idPlaceOfIssueArabic             String?
  passportPlaceOfIssueArabic       String?
  drivingLicenseTypeArabic         String?
  drivingLicensePlaceOfIssueArabic String?
  residentialAddressArabic         String?
  relativesNamesArabic             String?
  bankNameArabic                   String?
  bankBranchNameArabic             String?
  // --- Onboarding-only fields (self-service onboarding form) ---
  // NOTE: department, job category/level and hourly rate are NOT stored here — they're assigned
  // by the recruitment team on the Candidate (before the offer), not self-reported by the hire.
  serviceProviderCompany String? // Service Provider onboarding: the supplying company's name
  employeeTravelDate    DateTime? // Service Provider onboarding: travel date
  employeeStartDate     DateTime? // date the hire indicates they can start (from onboarding)
  ticketUrl             String? // Non-Resident / Service Provider onboarding: airplane ticket
  residencyDocumentUrl  String? // Non-Resident / Service Provider onboarding: residency document
  interviewEvaluationUrl String? // Service Provider onboarding: interview evaluation form
  jobDescriptionId       String?
  jobDescription         JobDescription?        @relation(fields: [jobDescriptionId], references: [id])
  contracts              Contract[]
  documents              EmployeeDocument[]
  personnelActionForms   PersonnelActionForm[]
  disciplinaryCases      DisciplinaryCase[]
  offboardingCases       OffboardingCase[]
  departmentEvaluations  DepartmentEvaluation[]
  directorEvaluations    DirectorEvaluation[]
  divisionEvaluations    DivisionEvaluation[]
  gmEvaluations          GMEvaluation[]
  chairmanEvaluations    ChairmanEvaluation[]
  divisionId             String?
  directorateId          String?
  directorate            Directorate?           @relation(fields: [directorateId], references: [id])
  division               Division?              @relation(fields: [divisionId], references: [id])
  department             Department?            @relation(fields: [departmentId], references: [id])
  group                  Group?                 @relation(fields: [groupId], references: [id])
  unit                   Unit?                  @relation(fields: [unitId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  hrEvaluations          HREvaluation[]
  leaveRequests          LeaveRequest[]
  payrollResults         PayrollResult[]
  personnelEvaluations   PersonnelEvaluation[]
  timeRecords            TimeRecord[]
  unitEvaluations        UnitEvaluation[]
  evaluationFinalizations EvaluationFinalization[]

  @@index([departmentId])
  @@index([unitId])
  @@index([groupId])
  @@index([jobDescriptionId])
  @@index([bioId])
}

// Free-form documents attached to an employee beyond the fixed onboarding slots (CV, degree,
// etc.) — e.g. a new certificate, a promotion letter, or any other file HR wants on file. Also
// used to log an update to one of the fixed slots, but those are still stored on Employee itself.
model EmployeeDocument {
  id             String   @id @default(uuid())
  employeeId     String
  name           String // HR-chosen label, e.g. "Training Certificate"
  fileUrl        String
  fileName       String? // original uploaded filename, for display
  uploadedByName String?
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Personnel Action Form (PAF) — an internal transfer. HR picks the target Job Description (which
// defines the destination division/department/unit/position/category); the DOCX is generated for
// physical signatures, the signed copy is uploaded, then on Accept the employee is moved into that
// JD and the signed form is filed under their Lifecycle documents. `current*` snapshots the
// placement at creation for the document + audit; `new*` mirrors the target JD's placement.
model PersonnelActionForm {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  actionType          String    @default("TRANSFER")
  status              String    @default("PENDING") // PENDING | ACCEPTED | REJECTED

  currentDivision     String?
  currentDepartment   String?
  currentUnit         String?
  currentPosition     String?
  currentJobCategory  String?
  currentJobGrade     String?
  currentPlaceOfWork  String?

  newJobDescriptionId String? // the target JD that drives the move
  newDivisionId       String?
  newDepartmentId     String?
  newUnitId           String?
  newPositionTitle    String?
  newJobCategory      String?
  newJobGrade         String?
  newPlaceOfWork      String?
  reportsTo           String?

  // Inter-company transfer (actionType = "INTER_COMPANY_TRANSFER"). The destination is another
  // company outside this system, so its org placement is captured as free text and the four factors
  // are entered on the form (not read from the Employee record).
  newCompany          String?
  newDivisionName     String?
  newDepartmentName   String?
  newUnitName         String?
  englishFactor       Float?
  positionFactor      Float?
  locationFactor      Float?
  skillFactor         Float?

  typeOfTransfer      String?
  effectiveDate       DateTime?
  justification       String?

  documentUrl         String?
  documentName        String?

  createdByName       String?
  decidedByName       String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

// A single disciplinary case, evolving through the company's real 4-stage process — confirmed
// directly against the official .docx templates (public/*.docx): each stage is one cycle of
// generate the form -> collect physical signature(s) -> upload the signed copy -> advance. The
// Investigation Result template already prints the Panel/Head-of-HR/Administrative-Director
// signature lines on that one document, so there is no separate system-level approval gate for
// them — just the one upload. `source` distinguishes a normal human-filed report from a case
// opened via the attendance-candidates screen (which starts directly at `DISCIPLINARY_ACTION`,
// since the violation — tardiness count — is already objectively proven by system data).
model DisciplinaryCase {
  id                  String    @id @default(uuid())

  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  caseNumber          String    @unique // "IR No" — IPH-CCHR-FRM-INCREP-000 style, incrementing, assigned at creation
  source              String    @default("EMPLOYEE_REPORT") // EMPLOYEE_REPORT | SYSTEM_ATTENDANCE
  reportedById        String?   // the logged-in filer, kept for internal accountability (null only for SYSTEM_ATTENDANCE cases)
  reportedBy          User?     @relation("DisciplinaryReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedByName      String?   // optional — the original submitter's name, for internal reference only
  reportedByEmail     String?   // optional contact email, for internal reference only
  reportedDate        DateTime? // "Date Reported" on the Incident Report form — editable, defaults to submission day
  preparedByName      String?   // "Prepared by" on the printed form — whoever finalizes the Incident Report document (usually HR), distinct from the original reporter
  preparedByNameAr    String?   // Arabic translation of the preparer's name

  subjectPositionTitle   String?  // snapshot of the subject employee's position at intake time (auto-filled, editable)
  subjectPositionTitleAr String?  // Arabic translation — filled in by HR if the reporter only gave one language
  subjectDepartment      String?  // snapshot of the subject employee's department at intake time (auto-filled, editable)
  subjectDepartmentAr    String?  // Arabic translation

  incidentDate        DateTime?
  incidentPlace       String?
  incidentPlaceAr     String?   // Arabic translation of the incident place
  incidentDescription String?
  incidentDescriptionAr String? // Arabic translation of the incident description
  violationId         String?   // unknown at intake — confirmed at Investigation Result (or set directly for SYSTEM_ATTENDANCE)
  category            String?   // MINOR | SERIOUS | MAJOR — set once violationId is confirmed
  offenseNumber       Int?      // computed once, at Investigation Result completion (or at attendance auto-execute)

  // Set only when a case is dismissed at Incident Report stage instead of proceeding to Notice to
  // Explain — distinguishes an intake dismissal from a normal NON_VIOLATION investigation closure
  // (that path always sets investigationOutcome; this one never does).
  closureReason       String?

  stage               String    @default("INCIDENT_REPORT") // INCIDENT_REPORT | NOTICE_TO_EXPLAIN | INVESTIGATION_RESULT | DISCIPLINARY_ACTION | CLOSED

  // Stage 1 — Incident Report: one generate+upload cycle
  incidentReportDocumentUrl   String?
  incidentReportDocumentName  String?
  incidentReportCompletedAt   DateTime?
  incidentReportCompletedById String?
  incidentReportCompletedBy   User?     @relation("DisciplinaryIncidentReportCompletedBy", fields: [incidentReportCompletedById], references: [id], onDelete: SetNull)

  // Stage 2 — Notice to Explain
  noticeToExplainDescription   String?   // HR's formal rewrite of the incident description for the printed notice — the original intake description is untouched
  noticeToExplainDescriptionAr String?   // Arabic version of the formal rewrite
  noticeToExplainDocumentUrl   String?
  noticeToExplainDocumentName  String?
  noticeToExplainCompletedAt   DateTime?
  noticeToExplainCompletedById String?
  noticeToExplainCompletedBy   User?     @relation("DisciplinaryNoticeToExplainCompletedBy", fields: [noticeToExplainCompletedById], references: [id], onDelete: SetNull)

  // Stage 3 — Investigation Result (Panel/Head-of-HR/Admin-Director sign-off is on this ONE document)
  investigationOutcome        String?   // NON_VIOLATION | MINOR | SERIOUS | MAJOR
  investigationResult         String?
  investigationResultAr       String?
  investigationRecommendation String?
  investigationRecommendationAr String?
  investigationActionTaken    String?
  investigationActionTakenAr  String?
  investigationDocumentUrl    String?
  investigationDocumentName   String?
  investigationCompletedAt    DateTime?
  investigationCompletedById  String?
  investigationCompletedBy    User?     @relation("DisciplinaryInvestigationCompletedBy", fields: [investigationCompletedById], references: [id], onDelete: SetNull)

  // Stage 4 — Notice of Disciplinary Action (skipped straight to for SYSTEM_ATTENDANCE cases)
  actionType             String?   // VERBAL_WARNING | WRITTEN_WARNING | SUSPENSION_3_DAYS | SUSPENSION_5_DAYS | SUSPENSION_7_DAYS | SUSPENSION_10_DAYS | TERMINATION
  actionEffectiveDate    DateTime?
  actionAdditionalInfo   String?
  actionDocumentUrl      String?
  actionDocumentName     String?
  actionCompletedAt      DateTime?
  actionCompletedById    String?
  actionCompletedBy      User?     @relation("DisciplinaryActionCompletedBy", fields: [actionCompletedById], references: [id], onDelete: SetNull)

  closedAt            DateTime?

  createdByName       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  evidence            DisciplinaryEvidence[]

  @@index([employeeId])
  @@index([stage])
  @@index([source])
  @@index([violationId])
}

model DisciplinaryEvidence {
  id             String           @id @default(uuid())
  caseId         String
  case           DisciplinaryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String?
  uploadedByName String?
  createdAt      DateTime         @default(now())

  @@index([caseId])
}

model OffboardingCase {
  id                  String    @id @default(uuid())

  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  caseNumber          String    @unique // "IPH-CCHR-FRM-OFFBRD-000" style, same convention as disciplinary

  type                String    // VOLUNTARY | INVOLUNTARY
  // The 4 real separation types, each reachable through its own path: EMPLOYEE_RESIGNATION (self-
  // service Resignation Request, or manually recorded by HR) | DISCIPLINARY_TERMINATION (auto-created
  // when a Disciplinary Action reaches Termination) | TERMINATION (HR manually records a termination
  // with no disciplinary case behind it) | CONTRACT_NON_RENEWAL_EMPLOYEE | CONTRACT_NON_RENEWAL_COMPANY
  source              String
  // Set only when source = DISCIPLINARY_TERMINATION — the Disciplinary Action whose TERMINATION
  // penalty auto-created this case. Loose reference (no relation) since a DisciplinaryCase is never
  // deleted once closed and this is purely informational/cross-link, matching how violationId
  // references the static catalog "by convention" rather than a DB FK elsewhere in this schema.
  linkedDisciplinaryCaseId String?
  reason              String?

  // RESIGNATION_REQUEST (voluntary only — involuntary cases start straight at CLEARANCE, since the
  // Disciplinary Action's own Notice already serves as the separation notice) | CLEARANCE |
  // SEPARATION_LETTER | CLOSED
  stage               String    @default("RESIGNATION_REQUEST")

  // Stage 1 — Resignation Request (voluntary only): one generate+upload cycle. Intake fields below
  // mirror the real Google Form 1:1 — identity fields (name/unit/department/position) are NOT stored
  // here since they're read live off the Employee relation at display/generation time.
  resignationFiledAt        DateTime?
  resignationReason         String?   // "Reason for Resignation" — short text, as typed by the employee
  // The printed form is bilingual, but the employee only ever types one language — same convention
  // as disciplinary's incidentDescription/incidentDescriptionAr: HR adds the other language's
  // version before generating the official document (see generateStageForm's RESIGNATION_REQUEST
  // branch), and it's persisted here for next time.
  resignationReasonAr       String?
  // "Head of Division" is NOT stored — resolved live at generation time from the org structure
  // (User.role = 'HEAD_DIVISION' + divisionId), same lookup leaveApprovalChain.ts already uses.
  resignationLetterText     String?   // "Resignation Letter" — required long text (the letter's own written content), as typed by the employee
  resignationLetterTextAr   String?   // HR-provided translation, same convention as resignationReasonAr
  resignationAttachmentUrls  String[] @default([]) // optional "Additional Attachments" — up to 10 files
  resignationAttachmentNames String[] @default([])
  resignationEffectiveDate  DateTime? // set from the Exit Interview's "Effective Date of Resignation" once submitted
  resignationDocumentUrl    String?
  resignationDocumentName   String?
  resignationCompletedAt    DateTime?
  finalWorkingDate          DateTime?

  // Stage 2 — Employee Clearance (both types) — the 6-way sign-off (Head of Unit, Head of
  // Department, IT, Assets, Finance & Treasury, Head of HR) is one document, one physical-signature
  // round, one upload — same convention as every other multi-approver disciplinary stage.
  dateOfSeparation        DateTime?
  clearanceDocumentUrl    String?
  clearanceDocumentName   String?
  clearanceCompletedAt    DateTime?

  // Exit interview — in-system replacement for the external Google Form, field-for-field. Mandatory
  // for every case except source = DISCIPLINARY_TERMINATION (enforced in completeSeparationLetter).
  exitInterviewSubmittedAt    DateTime?
  exitInterviewReasonCategory String?   // one of REASON_FOR_LEAVING's values; 'OTHERS' pairs with exitInterviewReasonOther
  exitInterviewReasonOther    String?
  // 8-category rating scale, each one of 'EXCELLENT' | 'GOOD' | 'FAIR' | 'POOR'
  exitInterviewRatingManagement       String?
  exitInterviewRatingCompanyCulture   String?
  exitInterviewRatingPolicies         String?
  exitInterviewRatingWorkingConditions String?
  exitInterviewRatingCareerDevelopment String?
  exitInterviewRatingSalary           String?
  exitInterviewRatingBenefits         String?
  exitInterviewRatingTraining         String?
  exitInterviewAppreciatedMost        String?
  exitInterviewLikedLeast             String?
  exitInterviewImprovementSuggestions String?
  exitInterviewInterestedInReemployment Boolean?
  exitInterviewWouldRecommend Boolean?
  exitInterviewContactEmail   String?
  exitInterviewContactNumber  String?

  // Stage 3 — Separation Letter (both types) — the document submitted to Payroll for final-pay;
  // completing this closes the case.
  separationDocumentUrl   String?
  separationDocumentName  String?
  separationCompletedAt   DateTime?

  // Certificate of Employment — on-demand, not a gated workflow stage; only enabled once
  // clearanceCompletedAt is set.
  certificateIssuedAt     DateTime?
  certificateDocumentUrl  String?

  closedAt            DateTime?

  createdByName       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([employeeId])
  @@index([stage])
}

// System activity log — one row per state-changing action (create/update/delete). The acting
// user's name/role are snapshotted so history survives even if the user is later removed.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  userRole   String?
  action     String   // human label, e.g. "Created announcement"
  details    String?  // who/what the action was about, e.g. "for Hazem Adam Hussein (IPH-0125-001)"
  method     String   // POST | PUT | PATCH | DELETE
  path       String   // request path (no query string)
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A single promotion, evolving through the company's real 2-stage process — same "generate form ->
// collect physical signature(s) -> upload the signed copy -> advance" pattern as DisciplinaryCase/
// OffboardingCase. A normal (non-exceptional) case always starts at NOTICE_OF_PROMOTION; an
// exceptional one (HR manually promoting someone outside the normal eligibility flow) skips straight
// to PROMOTION_REPORT. Closing the case (completing Promotion Report) is what actually applies the
// grade change to the Employee record.
model PromotionCase {
  id                  String    @id @default(uuid())

  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  caseNumber          String    @unique // "IPH-CCHR-FRM-PROMOT-000" style, same convention as INCREP/OFFBRD

  isExceptional       Boolean   @default(false)
  toGrade             String    // target grade this case applies on close — fixed at creation, one of JOB_GRADES
  basis               String?   // 'TENURE' | 'EVALUATION' | 'EXCEPTIONAL' — how eligibility was reached, display/audit only
  reason              String?   // "Reason for Promotion" — printed on both forms
  effectiveDate       DateTime? // "Effectivity Date:" printed field — does NOT drive currentGradeSince, see completePromotionReport
  newJobTitle         String?
  newJobCategory      String?

  // Stage 2 — Promotion Report (skipped entirely for isExceptional cases, which start straight here
  // instead). The overall rating is a live snapshot of Employee.evaluationPoints and the 3 monthly
  // scores come from EvaluationFinalization — both computed at generation time, not typed by HR.
  performanceMarch            String?
  performanceApril            String?
  performanceMay              String?
  overallPerformanceRating    String?
  promotionReportDocumentUrl  String?
  promotionReportDocumentName String?
  promotionReportCompletedAt  DateTime?

  // NOTICE_OF_PROMOTION | PROMOTION_REPORT | CLOSED
  stage               String    @default("NOTICE_OF_PROMOTION")

  // Stage 1 — Notice of Promotion. Completing THIS stage no longer applies the grade change — that
  // now happens when Promotion Report (the last stage) completes, see completePromotionReport.
  noticeOfPromotionDocumentUrl  String?
  noticeOfPromotionDocumentName String?
  noticeOfPromotionCompletedAt  DateTime?

  closedAt            DateTime?

  createdByName       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([employeeId])
  @@index([stage])
}

// Rewards & Recognition — one generate-letter -> collect signature -> upload-signed-copy -> confirm
// cycle, same safety pattern as Disciplinary/Offboarding/Promotion (no bonusHolidays credit or other
// side effect happens until `completedAt` is set) — a single-click instant grant was tried first and
// replaced after the user flagged it as too error-prone for an action with real, hard-to-reverse
// effects. A case with `completedAt` null is a DRAFT (candidate selected, nothing applied yet).
model RewardCase {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  caseNumber String   @unique // "IPH-CCHR-FRM-REWARD-000" style, same convention as INCREP/OFFBRD/PROMOT

  type       String   // EMPLOYEE_OF_MONTH | ATTENDANCE_EXCELLENCE | EMPLOYEE_OF_YEAR | LOYALTY_MILESTONE

  period         String?   // 'YYYY-MM' (Month/Attendance) or 'YYYY' (Employee of Year); null for Loyalty
  milestoneYears Int?      // 5 or 10 — Loyalty only
  milestoneDate  DateTime? // joinDate + milestoneYears, snapshotted at grant — Loyalty only

  finalScoreSnapshot Float?  // the winning EvaluationFinalization.finalScore — Employee of Month only
  notes              String? // tie-break reasoning / selection justification — any type

  bonusLeaveDaysGranted Float  @default(0) // +1 (Month/Attendance) / +3 (Year) / 0 (Loyalty) — applied to Employee.bonusHolidays only once completed
  bonusPercent          Float? // % of salary — Year (HR-entered) / Loyalty (fixed 5 or 10); null otherwise

  // The signed Appreciation Letter (or whichever document HR collects signatures on) — completing
  // the case (setting completedAt) is what actually applies bonusLeaveDaysGranted to the employee.
  documentUrl  String?
  documentName String?
  completedAt  DateTime?

  // Year (Certificate of Appreciation) / Loyalty (watch/plaque) — both HR-fulfilled outside the
  // system, this is just an on/off "logged as done" flag, never a generated document. Only settable
  // once the case itself is completed (the paperwork should be signed before the physical item is
  // handed over).
  physicalRewardFulfilledAt DateTime?
  physicalRewardNote        String?

  // Appreciation Letter — available on any award type per the PDF spec ("all rewards except the
  // annual performance bonus trigger... Appreciation Letter"). Blocked pending template — see
  // rewardForms.ts.
  appreciationLetterUrl      String?
  appreciationLetterName     String?
  appreciationLetterIssuedAt DateTime?

  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Two unique constraints, not one: Postgres treats NULL as distinct from NULL, so each is inert
  // exactly for the types where its key column is always null — together they correctly dedupe every
  // award type (period-based types via the first, Loyalty via the second).
  @@unique([employeeId, type, period])
  @@unique([employeeId, type, milestoneYears])
  @@index([employeeId])
  @@index([type])
}

