rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return hasRole('SUPER_ADMIN');
    }
    
    // Users collection - only authenticated users can read/write their own data
    // Super admins can manage all
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    
    // Groups - Super admins only
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Departments - Super admins only for write, authenticated users can read
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Employees
    match /employees/{empId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Time records
    match /time_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }
    
    // HR evaluations
    match /hr_evaluations/{evalId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Department evaluations - Department heads, HR, and admins can write
    match /department_evaluations/{evalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('HEAD_DEPARTMENT') || hasRole('HEAD_DIRECTOR') || hasRole('HR_MANAGER');
    }
    
    // Personnel evaluations
    match /personnel_evaluations/{evalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('PERSONNEL') || hasRole('HR_MANAGER');
    }

    // Director evaluations - Directors, HR, and admins can write
    match /director_evaluations/{evalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('HEAD_DIRECTOR') || hasRole('HR_MANAGER');
    }
    
    // Evaluation periods - HR Managers and admins can manage
    // Evaluation periods - HR Managers and admins can manage
    match /evaluation_periods/{periodId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Payroll results - Admins and HR Managers can manage
    match /payroll_results/{payrollId} {
      allow read: if isAdmin() || hasRole('HR_MANAGER');
      allow write: if isAdmin() || hasRole('HR_MANAGER');
    }
  }
}
